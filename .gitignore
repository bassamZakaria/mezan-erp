node_modules/
# ...and node_modules as a SYMLINK, which `node_modules/` does not match.
# A worktree without its own install gets one pointed at the main checkout;
# `git add -A` will happily commit that absolute path if this line is missing.
node_modules
.DS_Store
dist/
.worktrees/
*.log
apps/desktop/release/
e2e-results/
playwright-report/
blob-report/
mezan.db
mezan.db-*
*.sqlite
*.sqlite-*

# Playwright/browser-automation scratch output
.playwright-mcp/
*-dashboard.png
*-invoices.png
*-settings*.png

# Agent worktrees, not source
.claude/worktrees/

# No captured screens in the tree. Reviews run against the running app — a
# capture is stale the day after it is taken, and third-party UI must never be
# committed at all.
docs/reference-parity/screenshots/
.claude/stakeholders/screenshots/
# Local run database (scripts/dev.mjs, MEZAN_DB) — never a repo artifact.
local.db
local.db-*

# Generated by `pnpm trails` from docs/TESTING.md §14
docs/artifacts/trail-pack.html

# scratch DB for the router-migration worktree
router-dev.db*

# Local development database — a real SQLite file with user rows and
# credential hashes in it. Never a repo artefact.
dev.db
dev.db-*
sec.db
sec.db-*

# Coverage reports are build output — regenerate with `pnpm test:coverage`.
coverage/

# Agent scratch files — never part of the repo.
.tmp-*
**/__probe.test.ts
*.bak

# Local staging/testing databases (scripts/env.mjs)
.data/

*.tfstate
*.tfstate.*
crash.log
*.tfvars.local

test-results/

# Secrets: real env files, keys and certificates never enter the repo.
.env
.env.*
*.env
*.env.*
*.env~
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
!.env.example
!*.env.example
!apps/mobile/maestro/*.env
!test-fixtures/upgrade-matrix/*.audit-chain.key
