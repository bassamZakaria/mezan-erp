# apps/mobile runs on React 19 and every other workspace on React 18. pnpm's hidden
# hoist store keeps ONE copy per name, so hoisting @types/react put 19 where the web
# client's `react/jsx-runtime` resolves its types from — every JSX element in apps/web
# then failed to typecheck. Keep these two unhoisted so each package reads its own.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
