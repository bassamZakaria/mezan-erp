# Mezan application environment for the Contabo VPS.
# Copy to /srv/mezan/env (owner root, mode 0600). No real secret belongs in
# this file in git. Variables pinned in docker-compose.yml (MEZAN_PLATFORM_DIR,
# PORT, MEZAN_TRUST_PROXY, MEZAN_TRUSTED_PROXY_HOPS, MEZAN_SQLITE_EXCLUSIVE)
# win over anything set here, so they are not repeated.
# MEZAN_ORIGIN_SECRET lives in /srv/mezan/shared.env, which Caddy reads too.

# --- Public address -------------------------------------------------------
# Required once MEZAN_SMTP_HOST is set: every mailed link is built on it.
MEZAN_PUBLIC_URL=https://mezan.example.com
# Leave unset in code mode (one apex domain, tenant named by the company code).
# Set only for subdomain mode (README "Subdomain mode"): <code>.<domain>.
# MEZAN_TENANT_DOMAIN=

# --- Proxy trust: leave these unset on this box ---------------------------
# Only behind an edge that overwrites one header on every request (e.g.
# Cloudflare's cf-connecting-ip). Never switch on Cloudflare's proxy in front
# of this box without changing this, MEZAN_TRUSTED_PROXY_HOPS and the firewall.
# MEZAN_TRUSTED_CLIENT_ADDRESS_HEADER=

# --- Platform owner -------------------------------------------------------
MEZAN_PLATFORM_OWNER_EMAIL=owner@example.com
# Leave unset to have a password generated into
# /srv/mezan/data/platform-owner-password.txt on first boot (sign in, change
# it, delete the file).
# MEZAN_PLATFORM_OWNER_PASSWORD=

# --- Platform mail (signup, alerts, unlock links) -------------------------
# A transactional provider with SPF and DKIM on the sending domain; mail from
# a fresh VPS address goes to spam, and alerts depend on it.
MEZAN_SMTP_HOST=smtp.example.com
MEZAN_SMTP_PORT=587
# NONE, STARTTLS or TLS
MEZAN_SMTP_SECURITY=STARTTLS
MEZAN_SMTP_USERNAME=
MEZAN_SMTP_PASSWORD=
MEZAN_SMTP_FROM_NAME=Mezan
MEZAN_SMTP_FROM_EMAIL=no-reply@mezan.example.com
MEZAN_SUPPORT_EMAIL=support@mezan.example.com

# --- Alerts and logs ------------------------------------------------------
MEZAN_ALERT_EMAIL=bassam.s.zakaria@gmail.com
# debug, info, warn, error, fatal, silent
MEZAN_LOG_LEVEL=info
MEZAN_ENV=production
# MEZAN_SERVICE_NAME=mezan
# MEZAN_VERSION is stamped into the image at build time; do not set it here.

# --- Postgres (the books) -------------------------------------------------
# The app's login, mezan_app: not a superuser, it may only create and drop the
# per-company roles and schemas. deploy.sh creates the role and sets its
# password from this URL. Password: openssl rand -hex 32 (hex, so it needs no
# URL encoding).
MEZAN_DATABASE_URL=postgres://mezan_app:<64 hex>@postgres:5432/mezan
# Derives each company role's password (HMAC of the schema name); the app
# re-sets every served company's role at boot, so a rotation takes effect on
# the next restart. Generate with: openssl rand -hex 32
MEZAN_TENANT_DB_SECRET=

# --- Backups and audit anchors --------------------------------------------
# Audit-chain MAC key, 64 lower-case hex (openssl rand -hex 32). Set it BEFORE
# the first boot and never change it: every chain is keyed on it, and a
# restored database verifies only with the same key. Keep it in the password
# manager. Required: the Postgres server refuses to start without it, and
# deploy.sh refuses a missing or malformed value.
MEZAN_AUDIT_CHAIN_KEY=
# At most 30: a tenant idle for 30 minutes is closed and skipped by the timer.
MEZAN_BACKUP_INTERVAL_MINUTES=15
# Requests per minute on /api before a 429: per caller address (a whole office behind one router) and per signed-in session.
# Defaults 3000 and 600. A full page load makes 18-49 requests. The public API (/api/v1) keeps its own 120 per key.
# MEZAN_API_REQUESTS_PER_ADDRESS_PER_MINUTE=3000
# MEZAN_API_REQUESTS_PER_SESSION_PER_MINUTE=600
# Days an archived tenant's data is kept before the daily job deletes it (the privacy policy states this number).
MEZAN_TENANT_RETENTION_DAYS=90
# 32-byte key, 64 hex (openssl rand -hex 32). Encrypts tenant webhook secrets and SMTP passwords at rest.
# Set it before the first boot and never change or lose it, or every tenant must re-enter those secrets.
# Keep a copy in the password manager.
MEZAN_SECRETS_KEY=
# 32-byte Ed25519 seed, 64 lower-case hex. Keep a copy in the password manager.
MEZAN_AUDIT_ANCHOR_SIGNING_KEY=
# MEZAN_AUDIT_ANCHOR_PUBLIC_KEY=
# Public keys of retired signing keys, comma-separated (rotation).
# MEZAN_AUDIT_ANCHOR_TRUSTED_PUBLIC_KEYS=
MEZAN_AUDIT_ANCHOR_INTERVAL_MINUTES=15
# Bucket #2, created with Object Lock (README "Audit-anchor bucket").
MEZAN_AUDIT_ANCHOR_S3_BUCKET=mezan-audit-anchors
MEZAN_AUDIT_ANCHOR_S3_REGION=default
MEZAN_AUDIT_ANCHOR_S3_ENDPOINT=https://eu2.contabostorage.com
# MEZAN_AUDIT_ANCHOR_S3_PREFIX=audit-anchors
# Without a bucket, anchors go to /data/audit-anchors on this disk (not external).
# MEZAN_AUDIT_ANCHOR_DIR=
# Object-storage keys the anchor sink signs with.
MEZAN_AUDIT_ANCHOR_S3_ACCESS_KEY_ID=
MEZAN_AUDIT_ANCHOR_S3_SECRET_ACCESS_KEY=

# --- Card checkout (Paymob): all four keys or none ------------------------
# MEZAN_PAYMOB_SECRET_KEY=
# MEZAN_PAYMOB_PUBLIC_KEY=
# MEZAN_PAYMOB_HMAC_SECRET=
# MEZAN_PAYMOB_INTEGRATION_ID=
# Required with live keys.
# MEZAN_PAYMOB_PUBLIC_URL=https://mezan.example.com
# MEZAN_PAYMOB_API_KEY=
# MEZAN_PAYMOB_BASE_URL=https://accept.paymob.com
# MEZAN_PAYMOB_NOT_FOUND_CONFIRMED=
# Refused on a real platform (only with MEZAN_SEED_DEMO=1).
# MEZAN_PAYMOB_TEST_MODE=

# --- Optional -------------------------------------------------------------
# Cloudflare Web Analytics token; injects the beacon the CSP allows.
# MEZAN_ANALYTICS_TOKEN=
# 1 shows the public landing page (with live pricing) at / to signed-out visitors.
# Leave unset until the Terms of Service and privacy-policy TODOs are done.
# MEZAN_PUBLIC_LANDING=
# Store-reviewer tenant: both or neither, needs MEZAN_SUPPORT_EMAIL.
# MEZAN_REVIEW_TENANT_CODE=
# MEZAN_REVIEW_PIN=

# --- Never on this box ----------------------------------------------------
# MEZAN_SEED_DEMO / MEZAN_DEMO_PASSWORD: seed the public demo tenant whose
#   personas share the published PIN; production serves real tenants.
# MEZAN_SEED_ADMIN_PIN: the server refuses to start with it.
# MEZAN_WEB_DIST: the image's default (./apps/web/dist) is right.
# MEZAN_FAKE_TODAY: test clock.
