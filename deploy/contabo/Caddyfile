{
	email {$ACME_EMAIL}
	# SECURITY: CF-Connecting-IP is believed only from Cloudflare's ranges (www.cloudflare.com/ips), so a
	# proxied hostname still gives the app each visitor's address and a direct caller cannot forge one.
	# Refresh the list if Cloudflare publishes new ranges.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	import /etc/caddy/conf.d/*.caddyfile

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://mezan-erp-prod.firebaseapp.com https://mezan-erp-staging.firebaseapp.com https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	reverse_proxy mezan:9090 {
		# SECURITY: the origin secret proves to the app that a request crossed
		# this proxy; it overwrites whatever the caller sent under that name.
		header_up X-Mezan-Origin {$MEZAN_ORIGIN_SECRET}
		# The app trusts one hop and reads this as the visitor: Caddy's resolved client, never the caller's own header.
		header_up X-Forwarded-For {client_ip}
		# Trusted proxies would otherwise pass these through from the caller; the app resolves tenants and builds payment URLs from them.
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Request-Id {http.request.uuid}
	}
}
