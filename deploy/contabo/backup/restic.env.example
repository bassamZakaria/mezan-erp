# Copy to /srv/mezan/restic.env (root, 0600). Bucket #1: plain, versioned.
RESTIC_REPOSITORY=s3:https://eu2.contabostorage.com/mezan-backups/restic
# Or Google Drive through rclone, one folder per environment (staging: .../staging/restic):
#   RESTIC_REPOSITORY=rclone:gdrive:mezan-backups/production/restic
#   RCLONE_CONFIG=/srv/mezan/rclone.conf   (root, 0600: it holds the Drive login; needs apt install rclone)
# Also in the owner's password manager: without it the backups cannot be read.
# Generate with: openssl rand -base64 48
RESTIC_PASSWORD=
# restic reads the S3 protocol's standard variable names for any S3-compatible store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default
RESTIC_CACHE_DIR=/var/cache/restic
# Heartbeat (healthchecks.io or UptimeRobot); pinged after every good run,
# <url>/fail on a failed one. A missed ping is the alert.
BACKUP_HEARTBEAT_URL=
# mezan-pg-backup.sh, one heartbeat check per job, each pinged after a good run
# and at <url>/fail on a failed one. Suggested period / grace:
#   dump (hourly)        1 h / 2 h
#   base (daily)         1 day / 6 h
#   drill (weekly)       7 days / 1 day
PG_DUMP_HEARTBEAT_URL=
PG_BASE_HEARTBEAT_URL=
PG_DRILL_HEARTBEAT_URL=
# Weekly prune (mezan-backup.sh prune): period 7 days, grace 1 day.
PRUNE_HEARTBEAT_URL=
