# Copy to /srv/mezan/restic.env (root, 0600). Bucket #1: plain, versioned.
RESTIC_REPOSITORY=s3:https://eu2.contabostorage.com/mezan-backups/restic
# Also in the owner's password manager: without it the backups cannot be read.
# Generate with: openssl rand -base64 48
RESTIC_PASSWORD=
# restic reads the S3 protocol's standard variable names for any S3-compatible store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default
RESTIC_CACHE_DIR=/var/cache/restic
# Heartbeat (healthchecks.io or UptimeRobot); pinged after every good run,
# <url>/fail on a failed one. A missed ping is the alert.
BACKUP_HEARTBEAT_URL=
