# Copy to /srv/mezan/health-prod.env (root, 0600); read by mezan-health@prod.
# The public URL, so a broken Caddy or certificate also counts as down.
HEALTH_URL=https://mezan.cyag.net/readyz
# healthchecks.io "Mezan Prod Health check": period 10 minutes, grace 15 minutes.
# Pinged after a good check, <url>/fail on a bad one; a missed ping (the VPS is down) is the alert.
HEALTH_HEARTBEAT_URL=
