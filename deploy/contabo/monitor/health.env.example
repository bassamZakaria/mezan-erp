# Copy to /srv/mezan/health.env (root, 0600).
# The public URL, so a broken Caddy or certificate also counts as down.
HEALTH_URL=https://<domain>/readyz
# A healthchecks.io check, period 30 minutes, grace 10 minutes. Pinged after a
# good check, <url>/fail on a bad one; a missed ping (the VPS is down) is the alert.
HEALTH_HEARTBEAT_URL=
