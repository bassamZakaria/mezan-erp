# Read by the postgres container and the app. Copy to /srv/mezan/pg.env (root, 0600).

# The database owner. The app connects as this role only to provision tenants
# (one role and schema each); every tenant request runs as its own role.
POSTGRES_USER=mezan_owner
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# The app's view of the same credentials.
MEZAN_DATABASE_URL=postgres://mezan_owner:<POSTGRES_PASSWORD>@postgres:5432/mezan
# Derives each tenant role's password (HMAC of the schema name). Rotating it
# needs every tenant role's password reset. Generate with: openssl rand -hex 32
MEZAN_TENANT_DB_SECRET=

# Required once MEZAN_DATABASE_URL is set: the audit-chain MAC key, 64 lower-case
# hex (openssl rand -hex 32). On Postgres there is no file beside a database to
# mint one in, so the server refuses to start without it. Set it in
# /srv/mezan/env (where deploy.sh checks its format), not here: this file is
# also handed to the postgres container. Never change or lose it: every
# platform and tenant audit chain would then read as altered.
# MEZAN_AUDIT_CHAIN_KEY=
