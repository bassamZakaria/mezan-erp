# Read by the postgres container only. Copy to /srv/mezan/pg.env (root, 0600).
# Nothing of the app belongs here: deploy.sh refuses any MEZAN_* line.

# The cluster superuser. deploy.sh and the backup jobs use it for dumps,
# restores and role setup; the app never connects as it.
POSTGRES_USER=mezan_owner
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=mezan
