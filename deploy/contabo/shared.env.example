# Read by both containers. Copy to /srv/mezan/shared.env (root, 0600).
# Caddy gets only this file, never /srv/mezan/env.

# The apex domain Caddy serves and gets the HTTP-01 certificate for.
SITE_DOMAIN=mezan.example.com
# Let's Encrypt account address (expiry notices).
ACME_EMAIL=bassam.s.zakaria@gmail.com
# Caddy adds it as x-mezan-origin; the app refuses /api without it.
# Generate with: openssl rand -hex 32
MEZAN_ORIGIN_SECRET=
