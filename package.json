{
  "name": "mezan-erp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc -p tsconfig.json && pnpm --filter @mezan/ui typecheck && pnpm --filter web build",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @mezan/ui typecheck && pnpm --filter web typecheck",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "evidence:verify": "tsx scripts/evidence-verify.ts",
    "check:seed": "tsx scripts/check-seed-coverage.ts",
    "scenarios": "tsx scripts/run-scenarios.ts",
    "trails": "node scripts/build-trail-pack.mjs",
    "lint": "eslint . && pnpm run lint:rtl && pnpm run lint:tokens && pnpm run lint:controls && pnpm run lint:permission-labels && pnpm --filter @mezan/ui lint:theme",
    "lint:eslint": "eslint .",
    "lint:rtl": "node scripts/check-logical-css.mjs",
    "lint:tokens": "node scripts/check-color-tokens.mjs",
    "lint:controls": "node scripts/check-native-controls.mjs",
    "dev": "node scripts/dev.mjs",
    "env:testing": "node scripts/env.mjs testing",
    "env:testing:fresh": "node scripts/env.mjs testing --fresh",
    "env:staging": "node scripts/env.mjs staging",
    "env:staging:fresh": "node scripts/env.mjs staging --fresh",
    "dev:fresh": "node scripts/dev.mjs --fresh",
    "server": "tsx apps/server/src/index.ts",
    "licence:keygen": "node scripts/licence-keygen.mjs",
    "licence:issue": "node scripts/licence-issue.mjs",
    "licence:due": "node scripts/licence-due.mjs",
    "licence:server": "tsx apps/licence-server/src/index.ts",
    "desktop:demo": "pnpm --filter desktop demo",
    "desktop:package": "node scripts/package-desktop.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint:permission-labels": "node scripts/check-permission-labels.mjs",
    "test:changed": "vitest run --changed origin/main --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "vitest run --testNamePattern=fuzz",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:every-screen": "playwright test --config=playwright.every-screen.config.ts",
    "test:saas": "playwright test --config=playwright.saas.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.23.2",
    "fflate": "0.8.2",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
}
